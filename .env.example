# =============================================================================
# AI Music Style Database - environment configuration
# Copy to `.env` and fill in the values. NEVER commit real secrets.
# =============================================================================

# --- Public frontend configuration (safe to expose, bundled by Vite) --------
# Base path for GitHub Pages project sites, e.g. /ai-music-style-database/
VITE_BASE_PATH=/
# URL of the Submission API. Empty string means same-origin (dev proxy / combined deploy).
VITE_API_BASE_URL=
# Public repository URL used for "view entry" links.
VITE_REPOSITORY_URL=https://github.com/OWNER/REPOSITORY

# --- GitHub writer (server-side only, secret) --------------------------------
# app       -> use a real GitHub App (production, supports Pull Requests)
# dry-run   -> keep everything in memory and never contact GitHub (local dev)
# local-git -> commit/push with the machine's git+SSH credentials; direct
#              commits only (GITHUB_WRITE_MODE is forced to direct)
GITHUB_MODE=app
# pr     -> commit to a submissions branch and open a public Pull Request
# direct -> commit the change straight to GITHUB_BASE_BRANCH (no Pull Request,
#           no review; feedback comments are disabled in this mode)
GITHUB_WRITE_MODE=pr
GITHUB_OWNER=OWNER
GITHUB_REPOSITORY=REPOSITORY
GITHUB_BASE_BRANCH=main
GITHUB_APP_ID=123456
# PEM encoded private key. Newlines may be escaped with \n in a single line.
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# Optional: for GitHub Enterprise Server.
# GITHUB_API_URL=https://api.github.com
# local-git mode only: defaults to git@github.com:<owner>/<repository>.git
# GITHUB_REMOTE_URL=git@github.com:OWNER/REPOSITORY.git
# local-git mode only: dedicated clone directory (default ~/.cache/music-ai/repo)
# GITHUB_LOCAL_REPO_DIR=
# GITHUB_COMMIT_NAME=AI Music Style Database
# GITHUB_COMMIT_EMAIL=ai-music-style-database@users.noreply.github.com

# --- Database paths inside the repository -----------------------------------
MUSIC_DATABASE_PATH=data/music.json
STYLE_DATABASE_PATH=data/styles.json

# --- OpenCode analysis agent ------------------------------------------------
# cli   -> spawn a local `opencode` process (text models cannot read audio files)
# api   -> call the OpenCode Go/Zen API directly with OPENCODE_API_KEY; this is
#          the only mode where the model actually listens to the audio
# http  -> delegate to a remote OpenCode analysis gateway (OPENCODE_ENDPOINT)
# mock  -> deterministic offline classifier, for development/tests only
OPENCODE_MODE=api
OPENCODE_BIN=opencode
# api mode defaults to mimo-v2.6-flash; cli/http default to anthropic/claude-sonnet-4-5
OPENCODE_MODEL=mimo-v2.6-flash
OPENCODE_AGENT=music-classifier
OPENCODE_ENDPOINT=
OPENCODE_TIMEOUT_MS=120000
# Comma-separated allowlist of environment variables forwarded to the OpenCode child process.
OPENCODE_ENV_PASSTHROUGH=PATH,HOME,XDG_CONFIG_HOME,XDG_DATA_HOME,XDG_CACHE_HOME,ANTHROPIC_API_KEY,OPENAI_API_KEY,OPENROUTER_API_KEY,GEMINI_API_KEY
# Optional gateway authentication token (OPENCODE_MODE=http).
OPENCODE_GATEWAY_TOKEN=
# Port for `npm run start:gateway`.
GATEWAY_PORT=8788

# --- Direct OpenCode API mode (OPENCODE_MODE=api) ---------------------------
# OpenCode Go: https://opencode.ai/zen/go/v1  |  OpenCode Zen: https://opencode.ai/zen/v1
OPENCODE_API_URL=https://opencode.ai/zen/go/v1
OPENCODE_API_KEY=
# Optional explicit allowlist of media-capable models (comma separated).
# When empty the server discovers audio-capable models from GET /models joined
# with the models.dev catalogue. Only WAV and MP3 can be sent inline.
OPENCODE_MEDIA_MODELS=
OPENCODE_MAX_AUDIO_BYTES=12582912
# Only the first N seconds of a track are sent for analysis (0 disables).
# Long excerpts make analysis slow and expensive; 90-150s is plenty for style.
OPENCODE_MAX_AUDIO_SECONDS=120
OPENCODE_MAX_OUTPUT_TOKENS=3000
OPENCODE_MODEL_CATALOG_URL=https://models.dev/api.json
OPENCODE_MODEL_CATALOG_TTL_MS=21600000

# --- Similar-artist discovery (music-map.com) -------------------------------
# Powers the "Find neighbors" button in the Database view. Responses are
# cached and upstream requests are rate-limited to at most one per second.
MUSIC_MAP_ENABLED=true
MUSIC_MAP_BASE_URL=https://www.music-map.com
MUSIC_MAP_TIMEOUT_MS=8000
MUSIC_MAP_CACHE_TTL_MS=21600000
MUSIC_MAP_MAX_NEIGHBORS=24

# --- Song identification (lyrics -> title/artist) ---------------------------
# OpenCode transcribes lyrics and proposes a song; the server verifies the
# match against the configured metadata provider before it is written anywhere.
SONG_LOOKUP_ENABLED=true
SONG_LOOKUP_PROVIDER=musicbrainz
SONG_LOOKUP_TIMEOUT_MS=8000
# Minimum MusicBrainz relevance score (0-100) required to accept a match.
SONG_MATCH_MIN_SCORE=75
MUSICBRAINZ_BASE_URL=https://musicbrainz.org
MUSICBRAINZ_USER_AGENT=AI-Music-Style-Database/1.0 (+https://github.com/OWNER/REPOSITORY)
# Secret used to sign stateless feedback tokens. Falls back to RATE_LIMIT_SALT.
FEEDBACK_TOKEN_SECRET=

# --- Classification policy --------------------------------------------------
MIN_STYLE_CONFIDENCE=0.7
# Number of example tracks sent to the model as context.
MAX_CONTEXT_EXAMPLES=24
MAX_CONTEXT_EXAMPLES_PER_STYLE=3

# --- Abuse protection -------------------------------------------------------
MAX_UPLOAD_SIZE=26214400
MAX_FILENAME_LENGTH=200
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=6
MAX_CONCURRENT_ANALYSES=2
# Comma separated list of allowed browser origins.
ALLOWED_ORIGINS=http://localhost:5173

# --- Server -----------------------------------------------------------------
PORT=8787
LOG_LEVEL=info
# Serve the built Vue app (dist/) from the same container/origin as the API.
# The Docker image enables this by default.
SERVE_STATIC=false
STATIC_DIR=dist
# Salt used to derive rate-limit keys; raw IP addresses are never persisted.
RATE_LIMIT_SALT=change-me-to-a-random-value
